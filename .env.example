# SpecSignal 환경변수 예시. 이 파일을 .env로 복사한 뒤 값을 채우세요.
# .env는 .gitignore에 포함되어 Git에 올라가지 않습니다. 실제 키를 이 파일에 쓰지 마세요.

# ── 공공데이터포털 (백엔드 전용) ────────────────────────────────────────────
DATA_GO_KR_API_KEY=

# ── Supabase: 프론트엔드에 노출해도 되는 값 ─────────────────────────────────
# 대시보드 > Project Settings > API (Data API / API Keys)
SUPABASE_URL=https://mkcgobaupkpechhflnzr.supabase.co
# Publishable key (sb_publishable_...) 또는 레거시 anon key. RLS가 적용되는 공개 키입니다.
SUPABASE_PUBLISHABLE_KEY=

# ── Supabase: 백엔드 전용 (프론트엔드·Git·로그에 절대 노출 금지) ─────────────
# 대시보드 > Connect > Session pooler 연결 문자열 (IPv4 지원). [YOUR-PASSWORD]를 DB 비밀번호로 교체.
# 비밀번호에 특수문자가 있으면 URL 인코딩하세요 (예: @ → %40).
SUPABASE_DB_URL=postgresql://postgres.mkcgobaupkpechhflnzr:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
# 레거시 HS256 JWT를 사용하는 경우에만 설정 (Project Settings > JWT Keys > Legacy JWT secret).
# 비대칭 서명키(기본)를 사용하면 비워 두세요. 공개 JWKS로 토큰을 검증합니다.
SUPABASE_JWT_SECRET=
# 현재 백엔드는 secret key(sb_secret_... / service_role)를 사용하지 않습니다.
# 이후 Storage 서버 업로드 등에 필요해지면 SUPABASE_SECRET_KEY로 추가하고 백엔드에서만 읽으세요.

# ── 수집 주기 (선택, 기본값 표시) ────────────────────────────────────────────
# 정기 실행 시 마지막 성공 이후 이 시간이 지난 데이터만 다시 수집합니다.
CERT_LIST_REFRESH_HOURS=24
CERT_DETAILS_REFRESH_HOURS=24
CERT_SCHEDULE_REFRESH_HOURS=24
# 시험일정 수집 연도: 올해 기준 상대값 (0=올해, 1=내년)
CERT_SCHEDULE_YEAR_OFFSETS=0,1
# 공공데이터 API 호출 간 대기(초)
PUBLIC_API_REQUEST_INTERVAL_SECONDS=0.3
